# Salinan unit yang benar-benar berjalan di server produksi.
# Frontend memakai `next start` (build produksi sudah dibuat dengan `npm run build`).
# Cara pakai di mesin lain: sesuaikan WorkingDirectory, path node, dan port bila perlu,
# lalu `systemctl daemon-reload && systemctl enable --now anoni-frontend`.
[Unit]
Description=Anoni Frontend (Next.js)
After=network.target anoni-backend.service
Wants=anoni-backend.service

[Service]
Type=simple
WorkingDirectory=/root/anoni/frontend
Environment=NODE_ENV=production
ExecStart=/root/.hermes/node/bin/node /root/anoni/frontend/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
