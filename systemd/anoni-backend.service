# Salinan unit yang benar-benar berjalan di server produksi.
# Cara pakai di mesin lain: sesuaikan tiga hal berikut, lalu `systemctl daemon-reload`.
#   WorkingDirectory  -> letak repo Anda
#   EnvironmentFile   -> berkas .env backend Anda (DATABASE_URL, JWT_SECRET, FRONTEND_URL, ...)
#   ExecStart         -> path node Anda (mis. /usr/bin/node)
[Unit]
Description=Anoni Backend (Express + Socket.IO)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=/root/anoni/backend
EnvironmentFile=/root/anoni/backend/.env
ExecStart=/root/.hermes/node/bin/node src/index.js
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
